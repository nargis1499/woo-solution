# ── Supabase ──────────────────────────────────────────────────────────────────
# Dashboard → Project Settings → API (or the "Connect" dialog → Frameworks → Next.js)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# The "Publishable key" (sb_publishable_...). The legacy "anon" JWT key also works here.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Server-only. Needed by the dashboard's "New user" dialog (Users → New user): a login
# cannot be created through RLS, so the action calls Supabase's Admin API with this key.
# Also required for Stripe Checkout: its credentials live in a private, service-role-only
# table and signed webhooks reconcile orders with this client.
# Project Settings → API → Secret key (or the legacy "service_role" JWT). Never expose it.
# SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxx

# ── Site ──────────────────────────────────────────────────────────────────────
# Used to build the e-mail confirmation redirect URL. Set to your production URL when deploying.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_STORE_NAME=Woo Solution
# The store currency (USD or BDT) is set in the dashboard: Settings → WooCommerce → Currency.

# ── Stripe Checkout (optional fallbacks; normally configured in Nemesis → E-commerce → Payment) ──
# Database-saved credentials take priority. Use test keys while testing; never commit real values.
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_SECRET_KEY=sk_test_...        # or a restricted rk_test_... key with Checkout Sessions write access
# STRIPE_WEBHOOK_SECRET=whsec_...      # signing secret for <site>/api/stripe/webhook
# STRIPE_ENABLED=true                  # optional default when no database settings row can be read

# ── Nemesis AI (optional server fallbacks; normally configured in Settings → AI) ──
# GROQ_API_KEY=gsk_...
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GEMINI_API_KEY=AIza...
# OPENROUTER_API_KEY=sk-or-...
# OPENAI_ALT_TEXT_MODEL=gpt-4o-mini
